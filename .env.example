# Copy to .env and fill in. Never commit .env.
# Environment key + ID from your self-hosted Managed Agents environment (Console).
ANTHROPIC_ENVIRONMENT_KEY=
ANTHROPIC_ENVIRONMENT_ID=env_

# OmniRun endpoint that boots the microVMs. Use the hosted API, or your own
# OmniRun deployment. Needs the claude-agent template available.
OMNIRUN_API=https://api.omnirun.io
OMNIRUN_API_KEY=omr_

# Optional.
OMNIRUN_MAX_CONCURRENT=5

# Do NOT set ANTHROPIC_API_KEY here. The worker refuses to start if it is present.
